find_min_max() {
    local min=$1
    local max=$1
    
    for num in "$@"; do
        if [ $num -lt $min ]; then
            min=$num
        fi
        if [ $num -gt $max ]; then
            max=$num
        fi
    done
    
    echo "$min $max"
}

if [ $# -eq 0 ]; then
    echo "Error: No arguments provided" >&2
    exit 1
fi

for arg in "$@"; do
    if ! [[ $arg =~ ^-?[0-9]+$ ]]; then
        echo "Error: '$arg' is not a valid integer" >&2
        exit 1
    fi
done

result=$(find_min_max "$@")

read min max <<< "$result"

echo "Min: $min, Max: $max"
exit 0