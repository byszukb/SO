#!/bin/bash

znajdz_najwieksze() {
    if [ $# -ne 2 ]; then
        echo "Blad: Oczekiwano 2 argumentow" >&2
        return 1
    fi
    
    if [ ! -d "$1" ]; then
        echo "Blad: Katalog nie istnieje" >&2
        return 1
    fi
    
    if ! [[ "$2" =~ ^[0-9]+$ ]] || [ "$2" -le 0 ]; then
        echo "Blad: N musi byc liczba dodatnia" >&2
        return 1
    fi
    
    katalog="$1"
    n="$2"
    
    pliki=$(find "$katalog" -maxdepth 1 -type f)
    
    if [ -z "$pliki" ]; then
        echo "Katalog jest pusty"
        return 0
    fi
    
    calkowity_rozmiar=0
    while read rozmiar sciezka; do
        calkowity_rozmiar=$((calkowity_rozmiar + rozmiar))
    done < <(find "$katalog" -maxdepth 1 -type f -exec wc -c {} \;)
    
    while read rozmiar pelna_sciezka; do
        nazwa=$(basename "$pelna_sciezka")
        procent=$(echo "scale=2; $(echo "$rozmiar * 100" | bc) / $calkowity_rozmiar" | bc)
        echo "$nazwa $rozmiar $procent%"
    done < <(find "$katalog" -maxdepth 1 -type f -exec wc -c {} \; | sort -rn -k1 | head -n "$n")
}

znajdz_najwieksze "$@"

